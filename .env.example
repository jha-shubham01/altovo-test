# Altovo DocQA — environment template.
# Copy to .env.local (frontend) / set in Vercel project settings (backend).
# The AI assistant never reads or writes the real .env (D17) — the developer owns keys.

# --- Supabase (server-side only; service key must NOT be exposed to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# --- Gemini (one free key runs the whole app) ---
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides (defaults in api/config.py). Leave these commented
# unless you need to pin — IDs drift; verify against the live model list.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_GENERATION_MODEL=gemini-3.7-flash
# GEMINI_GENERATION_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Retrieval tuning (optional; defaults were calibrated against the bundled
# test corpus — see docs/decisions.md "SIM_FLOOR calibration". Re-measure with
# scripts/calibrate_floor.py, running the API under SIM_FLOOR=0) ---
# SIM_FLOOR=0.60
# WEAK_MATCH_MARGIN=0.03

# --- Frontend (browser-visible; used only for local dev where API is on another port) ---
# In production the frontend and API share an origin, so this can stay empty.
NEXT_PUBLIC_API_BASE_URL=
